{
  "schemaVersion": 1,
  "id": "mineagent",
  "version": "${version}",
  "name": "CraftDroid",
  "description": "AI-powered Minecraft companions that mine, build, fight, and explore alongside you. CraftDroid is forked from MineAgent.",
  "authors": [
    "kylejckson (CraftDroid fork)",
    "bingdongni (MineAgent upstream)"
  ],
  "contact": {
    "homepage": "https://github.com/kylejckson/CraftDroid",
    "sources": "https://github.com/kylejckson/CraftDroid",
    "issues": "https://github.com/kylejckson/CraftDroid/issues"
  },
  "license": "LGPL-3.0-only",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.mineagent.fabric.MineAgentFabric"
    ],
    "client": [
      "com.mineagent.fabric.MineAgentFabricClient"
    ]
  },
  "mixins": [
    "mineagent.mixins.json"
  ],
  "accessWidener": "mineagent.accesswidener",
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "=1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {}
}
